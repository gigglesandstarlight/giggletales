const pastelColors = [
  "#F7AFCB",
  "#CDB4F6",
  "#AEEBD3",
  "#BDE7FF",
  "#FFE59E",
];

function PatternLogo({ x, y, color, rotate = "0deg" }) {
  const coloredSvg = logoSvg.replaceAll("#000000", color);

  return (
    <View
      style={{
        position: "absolute",
        left: x,
        top: y,
        opacity: 0.50,
        transform: [{ rotate }],
      }}
    >
      <SvgXml xml={coloredSvg} width={110} height={110} />
    </View>
  );
}

export default function LogoPatternBackground({ children }) {
  const columnSpacing = 150;
  const rowSpacing = 110;
  const rows = 8;
  const columns = 4;

  const logos = [];

  for (let row = 0; row < rows; row++) {
    for (let col = 0; col < columns; col++) {
      logos.push({
        x: col * columnSpacing + (row % 2 === 0 ? 0 : columnSpacing / 2),
        y: row * rowSpacing,
        rotate: row % 2 === 0 ? "-6deg" : "6deg",
      });
    }
  }

  return (
    <View
      style={{
        flex: 1,
        backgroundColor: colors.card,
        overflow: "hidden",
      }}
    >
      {logos.map((logo, index) => (
        <PatternLogo
          key={index}
          x={logo.x}
          y={logo.y}
          rotate={logo.rotate}
          color={pastelColors[index % pastelColors.length]}
        />
      ))}

      <View style={{ flex: 1 }}>{children}</View>
    </View>
  );
}
